{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ocst/instance.schema.v1.json",
  "title": "OCST Instance Schema v1",
  "description": "Schema for Optimal Communication Spanning Tree problem instances. Graph and requirements are immutable; only metadata can change.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "graph",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier",
      "pattern": "^1\\.0$",
      "examples": ["1.0"]
    },
    "name": {
      "type": "string",
      "description": "Unique identifier for this instance",
      "minLength": 1,
      "examples": ["ocstpin0", "beasley_10"]
    },
    "tags": {
      "type": "array",
      "description": "Tags identifying instance family, benchmark group, or characteristics. 'quick_check' is reserved for fast regression subset.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "examples": [["beasley", "quick_check"], ["random_dense"]],
      "default": []
    },
    "graph": {
      "type": "object",
      "description": "Immutable graph structure (nodes and edges)",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "integer",
          "description": "Number of nodes in the graph",
          "minimum": 1
        },
        "edges": {
          "type": "array",
          "description": "List of edges in the graph (undirected)",
          "items": {
            "type": "object",
            "required": ["source", "destination", "cost"],
            "properties": {
              "source": {
                "type": "integer",
                "description": "Source node index (0-indexed)",
                "minimum": 0
              },
              "destination": {
                "type": "integer",
                "description": "Destination node index (0-indexed)",
                "minimum": 0
              },
              "cost": {
                "type": "number",
                "description": "Edge cost/weight",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "description": "Communication requirements between node pairs (immutable)",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "weight"],
        "properties": {
          "origin": {
            "type": "integer",
            "description": "Origin node index (0-indexed)",
            "minimum": 0
          },
          "destination": {
            "type": "integer",
            "description": "Destination node index (0-indexed)",
            "minimum": 0
          },
          "weight": {
            "type": "number",
            "description": "Communication requirement weight/demand",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metadata": {
      "type": "object",
      "description": "Mutable metadata about the instance (can evolve without affecting instance identity)",
      "properties": {
        "probability": {
          "type": "number",
          "description": "Graph density parameter (legacy field from .ocstpin format)",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "description": "Source paper or benchmark library",
          "examples": ["Beasley OR-Library", "Campos et al. INFORMS 2021"]
        },
        "generator": {
          "type": "string",
          "description": "Generator algorithm or method",
          "examples": ["erdos_renyi", "random", "manual"]
        },
        "coordinates": {
          "type": "array",
          "description": "Optional node coordinates for visualization",
          "items": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the instance"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last metadata modification"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

